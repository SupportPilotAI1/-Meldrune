# Internet version (Neon Postgres)
# Copy your Neon connection strings here / into Vercel's env vars. Never share these in chat.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional once deployed (trustHost is on, so Vercel works without it):
# AUTH_URL="https://your-app.vercel.app"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
